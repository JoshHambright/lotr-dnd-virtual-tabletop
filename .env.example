# Signs GM keys. Any long random string; the server refuses to start without
# one, because a table opened under a throwaway secret would not be the same
# table after a restart.
#
#   openssl rand -hex 32
TABLE_SECRET=

# Optional. A Cloudflare Tunnel token, if you want the table reachable from
# outside the house. Leave blank to keep it on localhost.
#   docker compose --profile tunnel up -d
TUNNEL_TOKEN=
