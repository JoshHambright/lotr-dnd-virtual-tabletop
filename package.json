{
  "name": "virtual-tabletop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted, ruleset-agnostic virtual tabletop for remote games",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @vtt/adapter-cloudflare dev",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm coverage && pnpm build",
    "demo": "pnpm --filter @vtt/client build:demo",
    "test:touch": "node scripts/touch-checks.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.4",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@10.33.0"
}
